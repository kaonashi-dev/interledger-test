# Copy this file to `.env` (Bun loads it automatically — no dotenv needed):
#   cp .env.example .env
#
# None of these are needed for `bun run simulate:dry`, which stubs every
# response and makes no network calls.

# The wallet address the payment is sent FROM. This is also the identity the
# client signs its requests with, unless CLIENT_WALLET_ADDRESS is set.
# Create one at https://wallet.interledger-test.dev and copy its payment
# pointer as a URL, e.g. https://ilp.interledger-test.dev/alice
SENDER_WALLET_ADDRESS=

# The wallet address the payment is sent TO. Must be a different wallet
# address (a second test wallet works fine), e.g.
# https://ilp.interledger-test.dev/bob
RECEIVER_WALLET_ADDRESS=

# Alias kept for backwards compatibility: if SENDER_WALLET_ADDRESS is unset,
# WALLET_ADDRESS is used instead. `bun run wallets` reads the same value.
WALLET_ADDRESS=

# The key id (kid) of the public key uploaded to the sender's wallet address.
# Shown in the test wallet UI when you add a developer key.
KEY_ID=

# The BASE64 encoding of your Ed25519 private key PEM FILE (not the PEM text).
# The test wallet gives you a `private.key` file; encode it with:
#   base64 -i private.key          # macOS
#   base64 -w0 private.key         # Linux
PRIVATE_KEY=

# Optional. The wallet address that identifies the GNAP client when signing
# requests. Defaults to SENDER_WALLET_ADDRESS, which is what you want unless
# you registered the key against a separate client wallet address.
CLIENT_WALLET_ADDRESS=

# Optional. Where the auth server redirects the account holder after they
# approve the interactive outgoing-payment grant. The `interact_ref` you paste
# back into the simulator is a query parameter on this URL.
# Defaults to http://localhost:3344/callback
INTERACT_REDIRECT_URI=
